{
  "name": "proxyforge",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch:upscaler": "node scripts/fetch-upscaler.mjs",
    "test": "vitest run",
    "test:rust": "cd src-tauri && cargo test --lib",
    "app": "pnpm fetch:upscaler && tauri dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/medievalsharp": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.73.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
