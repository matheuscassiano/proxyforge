{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyForge",
  "version": "0.1.1",
  "identifier": "com.proxyforge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProxyForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Print proxy cards at home",
    "longDescription": "Open-source desktop app to build and print proxy cards for trading card games, with colour management, AI upscaling and very high resolution exports.",
    "licenseFile": "../LICENSE",
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.icon"
    ]
  }
}
